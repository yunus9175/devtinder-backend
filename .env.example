# DevTinder Backend — Environment Configuration
# Copy this to .env and fill with your actual values (do NOT commit .env to git)

# ===== SERVER & DEPLOYMENT =====
# Port to run on (localhost)
PORT=8080

# API Base URL (full URL where your API is deployed or running locally)
# Local dev examples:
#   - http://localhost:8080/api/ (with base path /api)
#   - http://localhost:8080 (no base path)
# Production example:
#   - http://43.204.22.17/api/
API_BASE_URL=http://localhost:8080/api/

# Alternatively, use API_BASE_PATH to specify just the path (no full URL needed):
# API_BASE_PATH=/api

# ===== DATABASE =====
# MongoDB connection URI (Atlas example shown; replace with your values)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devTinder?retryWrites=true&w=majority

# ===== AUTHENTICATION =====
# JWT secret key (use a long, random string; NEVER share this)
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_production

# JWT expiration (default 10d)
JWT_EXPIRES=10d

# ===== COOKIES =====
COOKIE_NAME=token
COOKIE_EXPIRES_DAYS=10
COOKIE_HTTPONLY=true
# Set to true when deployed on HTTPS (production)
COOKIE_SECURE=false

# ===== CORS =====
# Comma-separated list of origins allowed to make requests to this API
# For production with frontend on a different origin: http://frontend-host:3000,http://another-origin
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===== OPTIONAL: LOCAL DEVELOPMENT =====
# If using local MongoDB instead of Atlas (when primary dev fallback fails):
# LOCAL_MONGODB_URI=mongodb://localhost:27017/devTinder
